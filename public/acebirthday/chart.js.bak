/* ============================================================
   CHART FILE — this is the only file you need to touch to make
   a chart for a new song.

   HOW IT WORKS
   ------------
   Notes are defined in BEATS, not seconds, since it's way easier
   to line notes up with a song's rhythm that way. The game
   converts beats -> seconds automatically using the BPM and
   OFFSET you set below.

   time_in_seconds = OFFSET + (beat / BPM) * 60

   1) Find your song's BPM (google "[song name] bpm", or use a
      tap-bpm site, or just guess and adjust — see step 3).
   2) OFFSET is how many seconds into the song the first beat
      (beat 0) actually happens. Listen to the song and find
      where beat 1 of the music lands.
   3) Play the game and see if notes line up with the music.
      If everything feels early, increase OFFSET. If late,
      decrease it. If notes drift out of sync as the song goes,
      your BPM is slightly off — nudge it up/down by 0.1-0.5.

   LANES: 0 = D (left), 1 = F, 2 = J, 3 = K (right)

   NOTE SHORTHAND
   --------------
   Use the helper functions below instead of writing raw objects:

     n(beat, lane)              -> single note
     row(beat, [lanes...])      -> a "jump" — multiple notes on
                                    the same beat (great for
                                    accents/drum hits)

   EXAMPLE — a basic 4-beat pattern repeated:
     n(0, 0), n(1, 1), n(2, 2), n(3, 3),
     n(4, 0), n(4, 3),                further jump
     n(5, 1), n(5.5, 2),              off-beat note (eighth note)

   Fractional beats work fine: 0.5 = an eighth note after beat 0,
   0.25 / 0.75 = sixteenth notes, 0.333 ~ a triplet subdivision.
   ============================================================ */

// ---- helper functions, do not need to edit these ----
function n(beat, lane) {
  return { beat, lane };
}
function row(beat, lanes) {
  return lanes.map(lane => n(beat, lane));
}
function stream(startBeat, lanePattern, beatStep) {
  // repeats a lane pattern (e.g. [0,1,2,3]) every `beatStep` beats
  // useful for quickly filling in a verse/chorus without typing every note
  const notes = [];
  lanePattern.forEach((lane, i) => {
    notes.push(n(startBeat + i * beatStep, lane));
  });
  return notes;
}

// ============================================================
// EDIT EVERYTHING BELOW THIS LINE FOR YOUR SONG
// ============================================================

const CHART = {
  songTitle: "Put Your Song Title Here",

  // --- timing setup ---
  bpm: 120,        // <-- change to your song's BPM
  offset: 0.5,     // <-- seconds until beat 0 hits (adjust for sync)

  // --- scroll speed: how many seconds a note takes to fall from
  // top of screen to the receptor line. Lower = faster/harder. ---
  approachTime: 1.4,

  // --- the birthday message shown on the results screen ---
  birthdayMessage: "Happy birthday, you absolute legend. Hope your year is as good as your combo just was. 🎂",

  // --- the notes! this is a placeholder demo pattern (~16 bars
  // of a simple 4/4 groove at 120bpm). Delete/replace with your
  // own chart once you know the song's BPM & offset. ---
  notes: [
    ...stream(0, [0, 1, 2, 3], 1),
    ...stream(4, [3, 2, 1, 0], 1),
    ...row(8, [0, 3]),
    n(9, 1),
    n(10, 2),
    ...row(11, [0, 1, 2, 3]),

    ...stream(12, [0, 1, 2, 3], 0.5),
    ...stream(14, [3, 2, 1, 0], 0.5),

    ...row(16, [1, 2]),
    n(17, 0),
    n(17.5, 3),
    n(18, 1),
    n(18.5, 2),
    ...row(19, [0, 1, 2, 3]),

    ...stream(20, [0, 2, 1, 3], 1),
    ...stream(24, [0, 2, 1, 3], 1),

    ...row(28, [0, 3]),
    ...row(29, [1, 2]),
    ...row(30, [0, 3]),
    ...row(31, [0, 1, 2, 3]),
  ]
};
